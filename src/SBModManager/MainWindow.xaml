<Window
    x:Class="SBModManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="剑星 MOD 管理器">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom title bar (drag region is the icon + title area)  -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <!--  Left inset matches the icon column of the NavigationView items below.  -->
            <Grid
                x:Name="DragRegion"
                Padding="16,0,0,0"
                Background="Transparent">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="TitleShift" />
                </Grid.RenderTransform>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="9"
                    VerticalAlignment="Center">
                    <Image
                        Width="16"
                        Height="16"
                        Source="ms-appx:///Assets/app.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="剑星 MOD 管理器" />
                </StackPanel>
            </Grid>

            <!--  Back button floats above the pane-toggle column; it must not shift the title.  -->
            <Button
                x:Name="BackButton"
                Width="32"
                Height="32"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="BackButton_Click"
                CornerRadius="4"
                Opacity="0"
                Visibility="Collapsed">
                <ToolTipService.ToolTip>
                    <ToolTip Content="返回上一页" />
                </ToolTipService.ToolTip>
                <FontIcon FontSize="12" Glyph="&#xE72B;" />
            </Button>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="190"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="模组管理" Tag="mods">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="N 网浏览" Tag="nexus">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="合集" Tag="collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="加载顺序" Tag="loadorder">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8CB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="方案" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="运行环境" Tag="runtime">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="DebugNavItem"
                    Content="调试"
                    Tag="debug"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="问题反馈" Tag="feedback">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE939;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="UpdateInfoBar"
                    Grid.Row="0"
                    Margin="24,12,24,0"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational"
                    Title="发现新版本" />

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
