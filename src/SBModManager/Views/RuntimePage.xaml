<Page
    x:Class="SBModManager.Views.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SBModManager.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer
        Padding="24,8,24,24"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch" Spacing="0">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="运行环境" />

            <!--  ===== 运行库 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="运行库" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="UE4SS 运行库" />
                            <TextBlock x:Name="StatusLine" Style="{StaticResource SettingsRowDescriptionStyle}" />
                            <TextBlock x:Name="PathLine" Style="{StaticResource SettingsRowDescriptionStyle}" />
                            <TextBlock x:Name="ReleaseLine" Style="{StaticResource SettingsRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="InstallUe4ssButton"
                                Click="InstallUe4ss_Click"
                                Content="下载并安装"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="从 Chrisr0/RE-UE4SS 下载最新 Release，并把 ue4ss 文件夹 + dwmapi.dll 复制到 SB\Binaries\Win64" />
                            <Button
                                x:Name="InstallLocalUe4ssButton"
                                Click="InstallLocalUe4ss_Click"
                                Content="从本地 zip 安装"
                                ToolTipService.ToolTip="选择任意 UE4SS 压缩包安装" />
                            <Button
                                x:Name="CheckUe4ssButton"
                                Click="CheckUe4ss_Click"
                                Content="检查更新" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8DA;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="打开相关目录" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="Win64 是 UE4SS 本体所在目录；ue4ss/Mods 是脚本模组目录。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="OpenBinaries_Click" Content="Win64 目录" />
                            <Button Click="OpenUe4ssMods_Click" Content="ue4ss/Mods" />
                            <Button Click="Refresh_Click" Content="刷新状态" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 脚本类模组 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="脚本类模组" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="已检测到的 UE4SS 模组" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="模组库中类型为 UE4SS 运行库或 UE4SS 脚本的模组。" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="Ue4ssList"
                        MaxHeight="360"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModItem">
                                <Grid Padding="16,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Subtitle}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StatusText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyHint"
                        Margin="52,4,16,14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="模组库中没有 UE4SS 相关模组。" />
                </StackPanel>
            </Border>

            <!--  ===== 安装说明 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="安装说明" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Padding="16,12" Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="• UE4SS：点「下载并安装」会取 Chrisr0/RE-UE4SS 的最新 Release，把压缩包里的 `ue4ss` 文件夹和 `dwmapi.dll` 复制到 SB/Binaries/Win64。&#x0a;• 也可以自己下载任意 UE4SS 压缩包后点「从本地 zip 安装」。&#x0a;• 脚本模组：压缩包内需要包含 scripts/main.lua，导入后部署到 SB/Binaries/Win64/ue4ss/Mods/&lt;名称&gt;，并自动创建 enabled.txt。&#x0a;• 内容模组（PAK）：导入后启用即可，文件会出现在 SB/Content/Paks/~mods。&#x0a;• 带 SB/ 目录的包（如 CNS 基础包）：会自动合并到游戏根目录。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
