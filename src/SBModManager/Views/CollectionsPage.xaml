<Page
    x:Class="SBModManager.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SBModManager.Views"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="24,8,24,24">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left" Spacing="12">
            <TextBlock Margin="0,4,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="合集" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="粘贴 Nexus 合集链接即可查看内容并批量安装；也支持 nxm://…/collections/… 链接。"
                TextWrapping="Wrap" />

            <!--  Input  -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="UrlBox"
                            Grid.Column="0"
                            PlaceholderText="https://www.nexusmods.com/games/stellarblade/collections/n7zgom"
                            KeyDown="UrlBox_KeyDown" />
                        <Button
                            x:Name="ParseButton"
                            Grid.Column="1"
                            Click="Parse_Click"
                            Content="解析合集"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            Click="Paste_Click"
                            Content="从剪贴板" />
                    </Grid>
                    <TextBlock
                        x:Name="StatusLine"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Parsed collection  -->
            <Border
                x:Name="CollectionCard"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="CollectionName"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="CollectionMeta"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="CollectionSummary"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="版本" />
                            <ComboBox
                                x:Name="RevisionBox"
                                MinWidth="110"
                                SelectionChanged="RevisionBox_SelectionChanged" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                            <Button
                                x:Name="InstallButton"
                                Click="Install_Click"
                                Content="下载并导入"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="CopyLinks_Click" Content="复制模组链接" />
                            <Button Click="OpenPage_Click" Content="打开合集页面" />
                            <Button
                                x:Name="CancelButton"
                                Click="Cancel_Click"
                                Content="停止"
                                IsEnabled="False" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <CheckBox
                            x:Name="IncludeOptionalBox"
                            Content="包含可选模组" />
                        <CheckBox
                            x:Name="SkipInstalledBox"
                            Content="跳过已安装的文件"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="EnableAfterBox"
                            Content="导入后自动启用" />
                    </StackPanel>

                    <ProgressBar
                        x:Name="InstallProgress"
                        Height="4"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ProgressText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Mod list  -->
            <Border
                x:Name="ModsCard"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="合集内容" />
                    <ListView
                        x:Name="ModsList"
                        MaxHeight="420"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CollectionModRow">
                                <Grid Padding="4,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SizeText}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind InstalledText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!--  Installed collections  -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="已安装的合集" />
                    <TextBlock
                        x:Name="InstalledEmpty"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="还没有通过合集导入的模组。" />
                    <ListView
                        x:Name="InstalledList"
                        MaxHeight="220"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:InstalledCollectionRow">
                                <Grid Padding="4,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind CountText}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="FilterInstalled_Click"
                                        Content="筛选模组"
                                        Tag="{x:Bind Tag}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!--  Recent collections  -->
            <Border
                x:Name="RecentCard"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="最近解析" />
                    <ListView
                        x:Name="RecentList"
                        MaxHeight="160"
                        IsItemClickEnabled="True"
                        ItemClick="Recent_ItemClick"
                        SelectionMode="Single" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
