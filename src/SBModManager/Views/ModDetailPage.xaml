<Page
    x:Class="SBModManager.Views.ModDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:SBModManager.Ui">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Hero: expands from the list item via connected animation  -->
        <Grid
            x:Name="HeroHost"
            Grid.Row="0"
            Height="240"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.9" />
            <Grid
                Padding="24,16"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="MetaText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Click="Close_Click"
                    Content="关闭"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="900"
                Padding="24,16,24,32"
                Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ToggleButton" Click="Toggle_Click" />
                    <Button Click="OpenFolder_Click" Content="打开模组目录" />
                    <Button x:Name="NexusButton" Click="OpenNexus_Click" Content="N 网页面" />
                    <Button x:Name="TranslateButton" Click="Translate_Click" Content="翻译说明" />
                    <ProgressRing
                        x:Name="TranslateRing"
                        Width="20"
                        Height="20"
                        IsActive="False" />
                </StackPanel>

                <TextBlock x:Name="StatusText" />
                <TextBlock x:Name="CnsText" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="说明" />
                <ContentControl x:Name="DescriptionHost" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="备注" />
                <ContentControl x:Name="NotesHost" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="部署到游戏的文件" />
                <TextBlock
                    x:Name="TargetsText"
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
