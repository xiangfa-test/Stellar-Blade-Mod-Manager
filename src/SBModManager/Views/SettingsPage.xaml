<Page
    x:Class="SBModManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        Padding="24,8,24,24"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch" Spacing="0">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="设置" />

            <!--  ===== 游戏 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="游戏" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7FC;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="游戏目录" />
                            <TextBlock x:Name="GameDirText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="Browse_Click" Content="浏览…" />
                            <Button Click="AutoDetect_Click" Content="自动检测" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="打开位置" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="游戏安装目录、模组库、~mods 目录、游戏配置与日志。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="OpenGameDir_Click" Content="游戏目录" />
                            <Button Click="OpenLibrary_Click" Content="模组库" />
                            <Button Click="OpenModsFolder_Click" Content="~mods" />
                            <Button Click="OpenConfig_Click" Content="配置" />
                            <Button Click="OpenLogs_Click" Content="日志" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE73E;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="验证安装" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="检查目录里是否有 SB.exe 与 SB/Content/Paks。" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="Validate_Click"
                            Content="验证" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8D8;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="游戏启动方式" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="通过 Steam 启动可保留成就与云存档。" />
                        </StackPanel>
                        <ComboBox
                            x:Name="LaunchModeBox"
                            Grid.Column="2"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            SelectionChanged="LaunchMode_Changed">
                            <ComboBoxItem Content="通过 Steam 启动" Tag="steam" />
                            <ComboBoxItem Content="直接运行 SB.exe" Tag="direct" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8CB;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="PAK 加载顺序前缀" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="给 ~mods 里的 pak 加 0001_ 这类序号前缀，让加载顺序真正影响覆盖；改变后需点「应用顺序并重建部署」重新部署。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="PakPrefixToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="PakPrefix_Toggled" />
                    </Grid>

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="捕获游戏崩溃" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="管理器运行时监控剑星进程；游戏异常退出后收集 WER 报告、转储和日志，给出简要原因分析并保存到数据目录的 crashes 文件夹。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="CrashCaptureToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="CrashCapture_Toggled" />
                    </Grid>

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="崩溃报告" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="查看已保存的游戏崩溃分析记录。" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Click="OpenCrashes_Click"
                            Content="打开文件夹" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 外观与行为 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="外观与行为" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="界面主题" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="跟随系统时使用 Windows 的浅色/深色设置。" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeBox"
                            Grid.Column="2"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            SelectionChanged="Theme_Changed">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="使用硬链接部署" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="同一磁盘时几乎瞬间完成且不额外占用空间；跨磁盘或失败时自动回退为复制。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="HardLinkToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="HardLink_Toggled" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7EF;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="启动时请求管理员权限" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="默认开启：启动时通过 UAC 以管理员身份重新运行，避免写入游戏目录/读取受保护目录被拒绝。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ElevateToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="Elevate_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 窗口 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="窗口" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE740;" Style="{StaticResource SettingsRowIconStyle}" />
                    <StackPanel Grid.Column="1" Spacing="0">
                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="窗口大小" />
                        <TextBlock
                            Style="{StaticResource SettingsRowDescriptionStyle}"
                            Text="恢复为默认大小（1280 × 820），并清除已记住的尺寸。" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Click="ResetWindowSize_Click"
                        Content="重置为默认大小"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!--  ===== 高级 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="高级" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7B8;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="显示调试页" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="在侧边栏显示「调试」页，用于运行自检、查看环境信息和清理临时文件。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="DebugToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="Debug_Toggled" />
                    </Grid>

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE71D;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="开始菜单快捷方式" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="在 Windows 开始菜单中创建「剑星 MOD 管理器」，按 Win 键即可找到。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StartMenuToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="StartMenu_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 网络与集成 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="网络与集成" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE774;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Nexus Mods API Key" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="用于「检查更新」与 nxm:// 直链下载（Nexus 账户设置里生成 Personal API Key）。" />
                            <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox
                                    x:Name="NexusKeyBox"
                                    Grid.Column="0"
                                    PlaceholderText="粘贴 API Key（仅保存在本机配置）" />
                                <Button
                                    Grid.Column="1"
                                    Click="SaveNexusKey_Click"
                                    Content="保存" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE71B;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="接管 nxm:// 链接（临时替代 Vortex）" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="开启后，Nexus 的「Mod Manager Download」按钮会交给本工具处理；关闭时恢复之前的处理程序。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="NxmToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="Nxm_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 应用更新 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="应用更新" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE895;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="检查更新" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="CheckUpdateButton"
                                Click="CheckUpdate_Click"
                                Content="检查更新" />
                            <Button
                                x:Name="ApplyUpdateButton"
                                Click="ApplyUpdate_Click"
                                Content="下载并更新"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OpenRelease_Click" Content="Release 页面" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        x:Name="UpdateProgress"
                        Height="4"
                        Margin="16,0,16,10"
                        Maximum="100"
                        Visibility="Collapsed" />

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE823;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="启动时自动检查更新" />
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionStyle}"
                                Text="启动后在后台检查 GitHub Release，发现新版本时在顶部提示；不自动下载。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="AutoUpdateToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="AutoUpdate_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 目录信息 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="目录" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Padding="16,12" Spacing="6">
                    <TextBlock x:Name="LibraryPathText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                    <TextBlock x:Name="DataPathText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                </StackPanel>
            </Border>

            <!--  ===== 支持的模组类型 =====  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="支持的模组类型" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Padding="16,12" Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="• PAK 模组：.pak / .ucas / .utoc，自动部署到 SB/Content/Paks/~mods&#x0a;• 资源模组：散装文件（如 DEK CNS 的 json 配置），部署到 ~mods/&lt;名称&gt;&#x0a;• UE4SS 运行库：dwmapi.dll + ue4ss 目录，部署到 SB/Binaries/Win64&#x0a;• UE4SS 脚本模组：含 scripts/main.lua 的模组&#x0a;• INI 配置：部署到 %LOCALAPPDATA%\\SB\\Saved\\Config\\WindowsNoEditor"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
