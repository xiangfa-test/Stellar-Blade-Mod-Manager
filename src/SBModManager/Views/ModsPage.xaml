<Page
    x:Class="SBModManager.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SBModManager.ViewModels"
    NavigationCacheMode="Required">

    <Grid
        x:Name="Root"
        Padding="24,8,24,12"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,4,0,10" Spacing="2">
            <TextBlock Text="模组管理" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="GamePathText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <InfoBar
            x:Name="MsgBar"
            Grid.Row="1"
            Margin="0,0,0,10"
            IsClosable="True"
            IsOpen="False" />

        <!--  Toolbar  -->
        <Grid Grid.Row="2" Margin="0,0,0,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="ImportButton"
                Grid.Column="0"
                Click="Import_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                    <TextBlock Text="导入模组" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Click="ImportArchive_Click" Text="导入压缩包 (.zip / .7z / .rar)" />
                        <MenuFlyoutItem Click="ImportFolder_Click" Text="导入文件夹" />
                        <MenuFlyoutItem Click="ImportPak_Click" Text="导入 .pak / .ucas / .utoc" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="1" Click="EnableAll_Click" ToolTipService.ToolTip="启用所有未启用的模组">
                <TextBlock Text="全部启用" />
            </Button>
            <Button Grid.Column="2" Click="DisableAll_Click" ToolTipService.ToolTip="停用所有已启用的模组">
                <TextBlock Text="全部停用" />
            </Button>
            <Button Grid.Column="3" Click="Refresh_Click" ToolTipService.ToolTip="重新扫描模组库和游戏目录">
                <FontIcon Glyph="&#xE72C;" />
            </Button>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="4"
                Width="190"
                HorizontalAlignment="Right"
                PlaceholderText="搜索模组…"
                QueryIcon="Find"
                TextChanged="Search_TextChanged" />

            <ProgressRing
                x:Name="BusyRing"
                Grid.Column="5"
                Width="20"
                Height="20"
                IsActive="False" />

            <Button Grid.Column="6" Click="LaunchGame_Click" Content="启动游戏" ToolTipService.ToolTip="启动《剑星》" />
            <Button Grid.Column="7" Click="More_Click" ToolTipService.ToolTip="更多操作">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Click="OpenModsFolder_Click" Text="打开 ~mods 目录" />
                        <MenuFlyoutItem Click="OpenLibraryFolder_Click" Text="打开模组库" />
                        <MenuFlyoutItem Click="OpenGameFolder_Click" Text="打开游戏目录" />
                        <MenuFlyoutItem Click="CheckAllUpdates_Click" Text="检查模组更新" />
                        <MenuFlyoutItem Click="ShowConflicts_Click" Text="冲突链分析" />
                        <MenuFlyoutItem Click="RedeployInOrder_Click" Text="按加载顺序重建部署" />
                        <MenuFlyoutItem Click="EditMeta_Click" Text="编辑标签 / 备注…" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OpenLogs_Click" Text="打开日志目录" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  Lists  -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar
                x:Name="Selector"
                Grid.Row="0"
                SelectionChanged="Selector_SelectionChanged">
                <SelectorBarItem IsSelected="True" Text="已管理模组" />
                <SelectorBarItem Text="游戏内外部文件" />
            </SelectorBar>

            <Grid
                x:Name="ModsView"
                Grid.Row="1"
                Margin="0,10,0,0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <ListView
                    x:Name="ModList"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind Mods}"
                    RightTapped="ModList_RightTapped"
                    SelectionChanged="ModList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModItem">
                            <Grid Padding="4,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ToggleSwitch
                                    Grid.Column="0"
                                    MinWidth="0"
                                    IsOn="{x:Bind Enabled, Mode=OneWay}"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="ModToggle_Toggled" />

                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        MaxLines="2"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TagsText}" />
                                        <TextBlock
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind UpdateText}"
                                            Visibility="{x:Bind UpdateVisibility}" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ConflictText}"
                                            Visibility="{x:Bind ConflictVisibility}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  Details  -->
                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <TextBlock
                            x:Name="DetailsEmpty"
                            Margin="4,8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="选择一个模组查看详情"
                            TextWrapping="Wrap" />

                        <ScrollViewer x:Name="DetailsScroll" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="DetailName"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailSubtitle"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock
                                    x:Name="DetailMeta"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailSource"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />

                                <StackPanel
                                    x:Name="VersionPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="已安装版本" />
                                    <ComboBox
                                        x:Name="VersionBox"
                                        MinWidth="210"
                                        DisplayMemberPath="VersionLabel"
                                        SelectionChanged="VersionBox_SelectionChanged" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="DetailTags"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailNotes"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailUpdate"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        x:Name="DetailPriority"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Click="MovePriorityUp_Click" Content="↑ 上移" />
                                    <Button Click="MovePriorityDown_Click" Content="↓ 下移" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="EditMeta_Click" Content="标签 / 备注" />
                                    <Button Click="CheckOneUpdate_Click" Content="检查更新" />
                                </StackPanel>

                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="部署到游戏的文件" />
                                <TextBlock
                                    x:Name="DetailTargetsText"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />

                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                                    <Button Click="OpenModDir_Click" Content="打开模组目录" />
                                    <Button Click="DeleteMod_Click" Content="删除模组" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid
                x:Name="ExternalView"
                Grid.Row="1"
                Margin="0,10,0,0"
                RowSpacing="8"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="不由本工具管理的 ~mods 文件" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="这些文件通常由 Vortex / 手动安装产生，可以在这里检查或删除。"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ListView
                    x:Name="ExternalList"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind Externals}"
                    RightTapped="ExternalList_RightTapped"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExternalItem">
                            <Grid Padding="4,6" ColumnSpacing="12">
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        MaxLines="2"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Subtitle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!--  Status bar  -->
        <Grid Grid.Row="4" Margin="0,10,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusLineText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                x:Name="CountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Page>
